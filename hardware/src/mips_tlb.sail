default Order dec

$include <prelude.sail>

// ============================================================
// Tessera — second MMU variant: the MIPS software-refill TLB
// (+ PageGrain 1 KiB / VPN2X).
//
// Variant 1 (`machine.sail`) models a *hardware* page-table walker
// (RISC-V Sv39).  MIPS has no hardware walker: a TLB miss traps to the
// OS, whose refill handler loads an entry (`tlbwr`/`tlbwi`).  That flips
// the trust line — "the MMU walks the table thus" becomes a *theorem
// about our software refill handler* (`mips_refill_lookup_covers`,
// proved in mips_tlb_proofs.v).
//
// This file is the self-contained Sail source of that variant (the Rocq
// is generated by build.sh; see doc/mips-software-refill.md for the
// rationale and the QEMU transcription source, and
// mips_qemu_oracle.v for the differential-test against QEMU's
// target/mips/tcg/system/{cp0_helper,tlb_helper}.c).
//
//   1. `compute_mask_level` — the PageMask decode (MD00091 §9.14, QEMU
//      `compute_pagemask`): the Mask field (extended by MaskX under ESP)
//      must be a run of 1s from the low end with an even count.  Returns
//      `Some k` (k = count) for a valid encoding, `None` otherwise.
//   2. `MipsEntry` / `mips_lookup` / `mips_refill` — a page-size-aware
//      TLB whose "lookup" is a fact about the *software* refill.
//
// The `esp` flag selects the 1 KiB base page (Config3.SP ∧ PageGrain.ESP,
// MD00091 §9.15): base_shift = 10 (1 KiB) vs 12 (4 KiB), and the VPN is
// VA[39:10] — the 30-bit VPN that carries EntryHi.VPN2X = VA[12:11]
// (MD00091 §9.30 Table 9.47) for 1 KiB pages.  `mips_vpn2x` exposes those
// two bits; under ESP=0 they are RAZ/WI (zero).  Page size =
// 2^(base_shift + level), so the level is the even PageMask count and the
// spectrum is the dense {4^k · M} menu.
// ============================================================

type vaddr = bits(64)
type paddr = bits(56)

// ---- PageMask decode (MD00091 §9.14, QEMU compute_pagemask) ----
//
// `reg` is the PageMask register value (bits [28:0] meaningful).  Under
// ESP the combined Mask+MaskX field is the 18 bits [28:11]; otherwise the
// 16-bit Mask field [28:13] (MaskX is RAZ/WI).  A valid encoding is a run
// of 1s from the low end with an even count; `cto18` counts trailing ones
// and `even` is the parity check, transcribed from QEMU's `cto32` and
// `(maskbits & 1) == 0`.

val even : int -> bool
function even(n) = (tmod_int(n, 2) == 0)

val cto18 : bits(18) -> int
function cto18(v) = count_trailing_zeros(not_vec(v))

val compute_mask_level : (bits(29), bool) -> option(int)
function compute_mask_level(reg, esp) = {
  let raw : bits(18) = reg[28 .. 11];
  let field : bits(18) = if esp then raw else sail_zero_extend(raw[17 .. 2], 18);
  let k = cto18(field);
  if (sail_shiftright(field, k) == sail_zeros(18)) & even(k) then Some(k) else None()
}

// ---- page-size interpretation ----

val mips_base_shift : bool -> int
function mips_base_shift(esp) = if esp then 10 else 12

val mips_page_shift : (bool, int) -> int
function mips_page_shift(esp, level) = mips_base_shift(esp) + level

// ---- the TLB entry and the software-refill lookup ----

struct MipsEntry = {
  vpn   : bits(30),   // VA[39:10] -- the VPN, incl. VPN2X (VA[12:11]) under ESP
  pfn   : bits(44),   // physical frame number
  level : int,        // page-size level: page = 2^(base_shift + level)
  esp   : bool        // 1 KiB base-page mode (Config3.SP && PageGrain.ESP)
}

// The VPN half of the match: va[39:10] as an unsigned int.
val mips_vpn_of : vaddr -> int
function mips_vpn_of(va) = unsigned(va[39 .. 10])

// The VPN2X bits (EntryHi[12:11] = VA[12:11]) -- the 1 KiB instantiation's
// distinguishing feature (MD00091 §9.30 Table 9.47).  Under ESP=0 they are
// RAZ/WI and always zero.
val mips_vpn2x : vaddr -> bits(2)
function mips_vpn2x(va) = va[12 .. 11]

// Coverage: vpn[29 .. shift] == va[39 .. (10 + shift)] where
// shift = level + (base_shift - 10) -- i.e. the low `shift` VPN bits (and
// the page offset below them) are don't-care.  Matching the doc's
// vpn[27..level] == va[39..(12+level)] formula, generalised to the 1 KiB
// base page.
val mips_covers : (MipsEntry, vaddr) -> bool
function mips_covers(e, va) = {
  let shift = e.level + (mips_base_shift(e.esp) - 10);
  sail_shiftright(e.vpn, shift) == sail_shiftright(va[39 .. 10], shift)
}

// Translation: pfn[43..level] @ va[ps-1..0] with ps = base_shift + level --
// the low `level` pfn bits (page-alignment) are dropped, the page offset is
// the low `ps` bits of the VA.
val mips_pa : (MipsEntry, vaddr) -> paddr
function mips_pa(e, va) = {
  let ps = mips_page_shift(e.esp, e.level);
  let pfn_hi = sail_shiftright(e.pfn, e.level);                      // bits(44)
  let off = sail_shiftright(sail_shiftleft(va, 64 - ps), 64 - ps);   // low ps bits of va
  sail_shiftleft(sail_zero_extend(pfn_hi, 56), ps) | sail_zero_extend(off[55 .. 0], 56)
}

// The software refill handler's effect: install/replace the entry.
val mips_refill : (MipsEntry, list(MipsEntry)) -> list(MipsEntry)
function mips_refill(e, tlb) = e :: tlb

// TLB lookup: first entry that covers the VA translates it.
val mips_lookup : (list(MipsEntry), vaddr) -> option(paddr)
function mips_lookup(tlb, va) = match tlb {
  [||] => None(),
  e :: rest => if mips_covers(e, va) then Some(mips_pa(e, va)) else mips_lookup(rest, va)
}
