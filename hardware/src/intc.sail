default Order dec

$include <prelude.sail>

// ============================================================
// Tessera — the interrupt controller (SSG-3): a GIC-SGI / RISC-V-AIA-IPI
// subset, modelled as the hardware that realizes the IPI mailbox.
//
// The shootdown IPI in machine.sail is a pure mailbox (`Machine.ipi`,
// `deliver_ipi`/`receive_ipi`): the leader marks core i's delivered bit, and
// the remote only flushes its TLB once the bit is set.  This file models the
// *device* that produces those delivered bits — the interrupt controller —
// with the stages every real controller has:
//
//   1. **Send** (`intc_send`) — the originator's MMIO write.  GIC: an SGI is
//      "generated by a write to an SGI register in the GIC" (IHI0069 4.4
//      Software Generated Interrupts);
//      it is edge-triggered: "asserted on detection of a rising edge of an
//      interrupt signal and then, regardless of the state of the signal,
//      remains asserted until the interrupt is acknowledged by software"
//      (IHI0069 1.2 Terminology, edge-triggered).  RISC-V: "a machine with
//      multiple harts must provide for each hart an implementation-defined
//      memory address that can be written to signal a machine-level software
//      interrupt at that hart"
//      (riscv-aia IPIs.adoc), or an MSI write to the destination's IMSIC
//      `seteipnum`.  The distributor latches the pending bit *regardless of
//      the mask* (the edge is recorded even for a masked PE).
//
//   2. **Mask** (`intc_mask`/`intc_unmask`) — the *per-interrupt* enable.
//      GIC's GICR_ISENABLER0 / GICR_ICENABLER0 for the SGI INTIDs 0-15
//      ("PPIs and SGIs can be enabled and disabled by writing to
//      GICR_ISENABLER0 and GICR_ICENABLER0", IHI0069 4.7.1 Enabling
//      individual interrupts), or RISC-V's `eie` array (IMSIC.adoc) /
//      `mie.MSIE`.  A masked interrupt stays pending but is not signalled.
//
//   3. **Interrupt context** (`intc_enter_context`/`intc_exit_context`) — the
//      *per-hart delivery gate*, distinct from (2).  GIC: the CPU interface's
//      interrupt enable / priority masking the kernel toggles when it enters
//      or leaves interrupt context (irq-disable).  RISC-V: `eidelivery`
//      ("controls whether interrupts from this interrupt file are delivered
//      from the IMSIC to the attached hart", IMSIC.adoc
//      IMSIC-reg-eidelivery) or `sstatus.SIE`.  A hart in interrupt context
//      (delivery = 0) *holds* its interrupts pending — it does not drop them —
//      and takes them only after it leaves the context.  This is the "no lost
//      or duplicated shootdown" half of SSG-3.
//
//   4. **Ack** (`intc_ack`) — the PE reads its interrupt (GIC's ICC_IAR /
//      RISC-V's `mip`/`*topei`).  If the interrupt is pending *and* unmasked
//      *and* delivery is enabled, the pending state is cleared for that PE
//      ("When a PE acknowledges the interrupt, the interrupt pending state is
//      cleared only for that PE", IHI0069 1.2 Terminology, Targeted list
//      model) and the doorbell rings — `ipi[i] := true`.  That delivered bit
//      is exactly `Machine.ipi`'s bit, so `send + ack` *refines* `deliver_ipi`
//      (proved in hardware/rocq/intc_proofs.v).
//
// The per-core lists are parallel to `Machine.cores`; `intc_ack` only ever
// touches core i's own bits (per-PE pending semantics).  Priority, groups and
// the active/EOI state are deliberate omissions (see
// doc/interrupt-controller.md, trust line): `*topei` would additionally select
// the *highest-priority* pending-and-enabled interrupt (lower identity number =
// higher priority, IMSIC.adoc), which the single-shootdown-IPI doorbell does
// not need.
// ============================================================

struct Intc = {
  pending  : list(bool),  // the per-core interrupt line (SGI pending / eip / GICR pending)
  masked   : list(bool),  // the per-interrupt enable, inverted (eie / GICR_ICENABLER0)
  delivery : list(bool),  // the per-hart delivery gate (eidelivery / sstatus.SIE / irq-disable)
  ipi      : list(bool)   // the software-visible mailbox (delivered bits)
}

// Set list element i (recursive; out-of-range index leaves the list alone).
val intc_set_bit : (list(bool), int, bool) -> list(bool)
function intc_set_bit(l, i, v) = match (l, i) {
  (_ :: rest, 0) => v :: rest,
  (x :: rest, n) => x :: intc_set_bit(rest, n - 1, v),
  ([||], _) => [||]
}

// Read list element i, with a default for out-of-range.
val intc_get_bit : (list(bool), int, bool) -> bool
function intc_get_bit(l, i, d) = match (l, i) {
  (x :: _, 0) => x,
  (_ :: rest, n) => intc_get_bit(rest, n - 1, d),
  ([||], _) => d
}

// intc_send: the originator's MMIO write (GICD_SGIR / the per-hart IPI
// address / IMSIC setipnum).  Edge-triggered and latched: pending[i] is set
// regardless of the mask or the delivery gate — a masked or in-context PE
// still records the interrupt; it is just not signalled on ack.
val intc_send : (Intc, int) -> Intc
function intc_send(ic, i) = struct {
  pending  = intc_set_bit(ic.pending, i, true),
  masked   = ic.masked,
  delivery = ic.delivery,
  ipi      = ic.ipi
}

// intc_mask: write GICR_ICENABLER0 (or clear the `eie` bit / mie.MSIE) — the
// per-interrupt enable is cleared.  A pending interrupt is held, not dropped.
val intc_mask : (Intc, int) -> Intc
function intc_mask(ic, i) = struct {
  pending  = ic.pending,
  masked   = intc_set_bit(ic.masked, i, true),
  delivery = ic.delivery,
  ipi      = ic.ipi
}

// intc_unmask: write GICR_ISENABLER0 (or set the `eie` bit / mie.MSIE) — the
// per-interrupt enable is set.  A held interrupt becomes deliverable on the
// next ack.
val intc_unmask : (Intc, int) -> Intc
function intc_unmask(ic, i) = struct {
  pending  = ic.pending,
  masked   = intc_set_bit(ic.masked, i, false),
  delivery = ic.delivery,
  ipi      = ic.ipi
}

// intc_enter_context: the kernel on hart i disables delivery (sstatus.SIE = 0 /
// eidelivery = 0) as it enters interrupt context.  Pending interrupts are held
// (not dropped); they become deliverable only on exit.
val intc_enter_context : (Intc, int) -> Intc
function intc_enter_context(ic, i) = struct {
  pending  = ic.pending,
  masked   = ic.masked,
  delivery = intc_set_bit(ic.delivery, i, false),
  ipi      = ic.ipi
}

// intc_exit_context: the kernel re-enables delivery (sstatus.SIE = 1 /
// eidelivery = 1) as it leaves interrupt context.
val intc_exit_context : (Intc, int) -> Intc
function intc_exit_context(ic, i) = struct {
  pending  = ic.pending,
  masked   = ic.masked,
  delivery = intc_set_bit(ic.delivery, i, true),
  ipi      = ic.ipi
}

// intc_ack: the PE reads its interrupt (ICC_IAR / mip / *topei).  If pending,
// unmasked and delivery-enabled, the pending state is cleared for this PE and
// the doorbell rings: ipi[i] := true — the delivered bit that
// Machine.ipi / receive_ipi consume.  Otherwise (masked, in-context, or
// nothing pending) the read is a spurious no-op: the controller state is
// unchanged.
val intc_ack : (Intc, int) -> Intc
function intc_ack(ic, i) = {
  let delivered = intc_get_bit(ic.pending, i, false)
                  & not_bool(intc_get_bit(ic.masked, i, false))
                  & intc_get_bit(ic.delivery, i, false);
  if delivered then struct {
    pending  = intc_set_bit(ic.pending, i, false),
    masked   = ic.masked,
    delivery = ic.delivery,
    ipi      = intc_set_bit(ic.ipi, i, true)
  } else ic
}
